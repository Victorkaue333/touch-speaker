<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Touch Speaker, macOS (spec distribuicao-windows-macos §17.1, ADR-10). Ad-hoc signature without the
     hardened runtime (D2): these keys only start to matter if a Developer ID with hardenedRuntime comes in.
     allow-jit: V8. device.audio-input: the microphone (with NSMicrophoneUsageDescription in Info.plist).
     disable-library-validation: the Electron framework and the .node files (koffi, uiohook-napi) do not carry
     the app's Team ID. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
